# ============================================================
# REBESTA BACKEND - ENVIRONMENT VARIABLES
# ============================================================
# Copy to .env and fill in real values. Never commit .env.

# --- Core ---------------------------------------------------
PORT=3000

# Signs every JWT (customer / partner / delivery). Required.
JWT_SECRET=change-me-to-a-long-random-string

# --- Supabase -----------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin panel --------------------------------------------
# Required for ALL /admin routes. Requests must send header:
#   x-admin-key: <this value>
# If unset, every /admin request is rejected (fails closed).
ADMIN_API_KEY=change-me-long-random

# --- Razorpay ------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Delivery / maps ----------------------------------------
# OpenRouteService (rider ETA / distance)
ORS_API_KEY=your-ors-key

# 2Factor (customer OTP SMS)
TWO_FACTOR_API_KEY=your-2factor-key

# Dispatch offer expiry (seconds) - optional
DISPATCH_OFFER_TTL_SECONDS=60
