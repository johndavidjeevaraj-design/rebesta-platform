# ============================================================
# REBESTA BACKEND - ENVIRONMENT VARIABLES
# ============================================================
# Copy to .env and fill in real values. Never commit .env.

# --- Core ---------------------------------------------------
PORT=3000
# Comma-separated exact browser origins (no trailing slash). Empty by default.
# Example: https://staging.rebesta.example,https://admin.rebesta.example
CORS_ALLOWED_ORIGINS=

# Signs every JWT (customer / partner / delivery). Required.
JWT_SECRET=change-me-to-a-long-random-string

# --- Supabase -----------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin panel --------------------------------------------
# Required for ALL /admin routes. Requests must send header:
#   x-admin-key: <this value>
# If unset, every /admin request is rejected (fails closed).
ADMIN_API_KEY=change-me-long-random

# --- Cashfree Payments --------------------------------------
# Use SANDBOX until staging payment tests are complete.
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=your-cashfree-app-id
CASHFREE_CLIENT_SECRET=your-cashfree-secret
# Optional; defaults to CASHFREE_CLIENT_SECRET when not separately configured.
CASHFREE_WEBHOOK_SECRET=
# Optional hosted redirect URL; the Flutter SDK handles native checkout.
CASHFREE_RETURN_URL=
# Public HTTPS endpoint configured for Cashfree PG payment/refund events.
CASHFREE_NOTIFY_URL=

# --- Delivery / maps ----------------------------------------
# OpenRouteService (rider ETA / distance)
ORS_API_KEY=your-ors-key

# 2Factor (customer OTP SMS)
TWO_FACTOR_API_KEY=your-2factor-key

# Dispatch offer expiry (seconds) - optional
DISPATCH_OFFER_TTL_SECONDS=60
