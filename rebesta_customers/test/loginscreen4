      borderRadius:
          BorderRadius.circular(28),

      border: Border.all(
        color: Colors.white.withValues(
          alpha: 0.70,
        ),
      ),
    ),

    child: Stack(
      children: [

        // ===============================================
        // SLIDING ORANGE CAPSULE
        // ===============================================

        AnimatedAlign(
          duration: const Duration(
            milliseconds: 300,
          ),

          curve: Curves.easeInOutCubic,

          alignment: isEmail
              ? Alignment.centerLeft
              : Alignment.centerRight,

          child: FractionallySizedBox(
            widthFactor: 0.5,

            child: Container(
              decoration: BoxDecoration(
                gradient:
                    const LinearGradient(
                  begin: Alignment.centerLeft,
                  end: Alignment.centerRight,
                  colors: [
                    Color(0xFFFFA51F),
                    Color(0xFFFF3D21),
                  ],
                ),

                borderRadius:
                    BorderRadius.circular(25),

                boxShadow: [
                  BoxShadow(
                    color: const Color(
                      0xFFFF6428,
                    ).withValues(
                      alpha: 0.20,
                    ),
                    blurRadius: 10,
                    offset: const Offset(0, 4),
                  ),
                ],
              ),
            ),
          ),
        ),

        // ===============================================
        // BUTTONS
        // ===============================================

        Row(
          children: [

            Expanded(
              child: _buildSwitchOption(
                selected: isEmail,
                icon: Icons.mail_outline_rounded,
                label: 'Email',

                onTap: () {
                  _changeLoginMethod(
                    LoginMethod.email,
                  );
                },

                size: size,
              ),
            ),

            Expanded(
              child: _buildSwitchOption(
                selected: !isEmail,
                icon: Icons.phone_outlined,
                label: 'Phone',

                onTap: () {
                  _changeLoginMethod(
                    LoginMethod.phone,
                  );
                },

                size: size,
              ),
            ),
          ],
        ),
      ],
    ),
  );
}
Widget _switchButton({
