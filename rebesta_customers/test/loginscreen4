                    (child, animation) {

                  final slideAnimation =
                      Tween<Offset>(
                    begin: const Offset(
                      0.03,
                      0,
                    ),
                    end: Offset.zero,
                  ).animate(
                    CurvedAnimation(
                      parent: animation,
                      curve: Curves.easeOutCubic,
